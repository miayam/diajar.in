---
interface Props {
    currentArticleId: string;
    threadId: string;
    threadArticles: Array<{ id: string; title: string }>;
}

const { currentArticleId, threadId, threadArticles } = Astro.props;

const currentIndex = threadArticles.findIndex(
    (article) => article.id === currentArticleId,
);

// If the current article isn't part of this thread, don't render anything
const isInThread = currentIndex !== -1;

const prevArticle =
    isInThread && currentIndex > 0 ? threadArticles[currentIndex - 1] : null;
const nextArticle =
    isInThread && currentIndex < threadArticles.length - 1
        ? threadArticles[currentIndex + 1]
        : null;

const isFirstArticle = isInThread && currentIndex === 0;
---

{
    isInThread && (
        <nav class="flex items-center justify-between py-8 border-t border-gray-300 mt-8">
            <div class="flex-1">
                {isFirstArticle && (
                    <a
                        href={`/threads/${threadId}`}
                        class="inline-flex items-center gap-2 py-2 font-semibold"
                    >
                        <span class="icon-chevron-left text-lg font-bold" />
                        <div>Sebelumnya</div>
                    </a>
                )}
                {prevArticle && (
                    <a
                        href={`/articles/${prevArticle.id}`}
                        class="inline-flex items-center gap-2 py-2 font-semibold"
                    >
                        <span class="icon-chevron-left text-lg font-bold" />
                        <div>Sebelumnya</div>
                    </a>
                )}
            </div>

            <div class="flex-1 flex justify-end">
                {nextArticle && (
                    <a
                        href={`/articles/${nextArticle.id}`}
                        class="inline-flex items-center gap-2 py-2 rounded-md font-semibold"
                    >
                        <div>Selanjutnya</div>
                        <span class="icon-chevron-right text-lg font-bold" />
                    </a>
                )}
            </div>
        </nav>
    )
}
