---
interface Props {
    count?: number;
}

const { count = 5 } = Astro.props;
const iterations = Array.from({ length: count });
---

<div class="m-skeletonArticles" id="article-skeleton">
    <div class="m-skeletonArticle__bar m-skeletonArticle__bar--title m-skeletonArticle__bar--w80 mb-4" />
    {iterations.map((_, index) => (
        <div class="m-skeletonArticle">
            <div class="m-skeletonArticle__bar" />
            <div class="m-skeletonArticle__bar" />
            <div class="m-skeletonArticle__bar" />
            <div class="m-skeletonArticle__bar" />
            <div class="m-skeletonArticle__bar m-skeletonArticle__bar--w80" />
        </div>
    ))}
</div>

<style>
    .m-skeletonArticle:first-child {
        margin-top: 0;
    }

    .m-skeletonArticle__bar {
        height: 20px;
        margin-top: 18px;
        animation: shimmer 2s infinite linear;
        background: linear-gradient(
            to right,
            #eff1f3 4%,
            #e2e2e2 25%,
            #eff1f3 36%
        );
        background-size: 700px 100%;
    }

    .m-skeletonArticle__bar--w80 {
        width: 80%;
    }

    .m-skeletonArticle__bar--title {
        height: 40px;
    }

    .m-skeletonArticle {
        margin-top: 30px;
        width: 0px;
        animation: fullView 0.5s forwards cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    @keyframes fullView {
        100% {
            width: 100%;
        }
    }

    @keyframes shimmer {
        0% {
            background-position: -700px 0;
        }
        100% {
            background-position: 700px 0;
        }
    }
</style>
